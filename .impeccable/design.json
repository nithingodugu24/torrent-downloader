  "narrative": {
    "northStar": "The Local Transfer Workspace",
    "overview": "The owner-supplied interface establishes a quiet utility workspace: a dark slate navigation rail, a pale working ground, white panels, and clear royal-blue actions. Compact typography and consistent alignment support repeated inspection of live transfers without turning the dashboard into decoration.\n\nVisual authority is `C:/Users/nithi/Downloads/torrent-downloader-redesigned.zip`, extracted for comparison in `.runtime/redesign-reference/`. The adopted system is implemented in `frontend/src/styles/redesign.css`, imported after `app.css` by `main.tsx`; both stylesheets contribute to the final cascade. The archive predates the current five-source search, so its visual language was merged into the working product rather than replacing its backend or current behavior. This name describes the adopted direction; it is not a new brand identity.",
    "keyCharacteristics": [
      "Slate navigation, pale ground, white working surfaces.",
      "Blue actions with restrained status colors and visible keyboard focus.",
      "Compact tables on desktop and readable transfer cards on narrow screens.",
      "Live state, qualified availability estimates, and progressive source feedback."
    ],
    "rules": [
      {
        "name": "The Meaningful Color Rule",
        "body": "Keep status labels and source feedback visible; color alone must not explain a transfer or availability state.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do follow the supplied archive's slate, blue, pale-ground, and white-surface direction.",
      "Do preserve readable muted labels, visible focus, wrapping names, and mobile action access.",
      "Do extend the same controls and surfaces to current search and VLC workflows.",
      "Do treat `.impeccable/review/` screenshots as QA evidence, not shipping image assets."
    ],
    "donts": [
      "Don't replace live state or current five-provider search with the archive's older implementation.",
      "Don't replace the supplied labels or typography with a newly invented visual identity.",
      "Don't imply that source counts guarantee speed or completion.",
      "Don't introduce decorative raster imagery into this utility interface; no generated raster assets ship in this redesign."
    ]
  }
}
